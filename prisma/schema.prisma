// Prisma schema file

datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?   // Hashed password
  image         String?
  role          String    @default("CUSTOMER") // "CUSTOMER", "ADMIN", "STAFF"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  orders        Order[]
  reservations  Reservation[]
  cateringReqs  CateringRequest[]
  giftCardsSent GiftCard[] @relation("SentGiftCards")
  rewardAccount RewardAccount?
  addresses     Address[]
  favorites     Favorite[]
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  street     String
  city       String
  state      String
  zipCode    String
  isDefault  Boolean  @default(false)
}

model MenuCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  order     Int        @default(0)
  items     MenuItem[]
}

model MenuItem {
  id            String         @id @default(cuid())
  categoryId    String
  category      MenuCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name          String
  slug          String         @unique
  description   String
  price         Float
  image         String
  isAvailable   Boolean        @default(true)
  isFeatured    Boolean        @default(false)
  isPopular     Boolean        @default(false)
  dietaryTags   String         // Comma separated e.g. "vegan,gluten-free"
  allergens     String         // Comma separated e.g. "nuts,dairy"
  spiceLevel    Int            @default(0) // 0=Mild, 1=Medium, 2=Hot
  
  // Relations
  modifierGroups MenuItemModifierGroup[]
  favorites      Favorite[]
  orderItems     OrderItem[]
}

model ModifierGroup {
  id          String                  @id @default(cuid())
  name        String
  minSelect   Int                     @default(0)
  maxSelect   Int                     @default(1)
  modifiers   Modifier[]
  menuItems   MenuItemModifierGroup[]
}

model MenuItemModifierGroup {
  menuItemId      String
  modifierGroupId String
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  @@id([menuItemId, modifierGroupId])
}

model Modifier {
  id              String        @id @default(cuid())
  groupId         String
  group           ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name            String
  price           Float         @default(0.0)
  isAvailable     Boolean       @default(true)
}

model Order {
  id             String      @id @default(cuid())
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  status         String      @default("NEW") // "NEW", "CONFIRMED", "PREPARING", "READY", "OUT_FOR_DELIVERY", "COMPLETED", "CANCELLED", "REFUNDED"
  type           String      // "PICKUP" or "DELIVERY"
  scheduledTime  DateTime?
  customerName   String
  customerEmail  String
  customerPhone  String
  
  // Delivery details
  deliveryStreet String?
  deliveryCity   String?
  deliveryState  String?
  deliveryZip    String?
  deliveryFee    Float       @default(0.0)
  
  subtotal       Float
  tax            Float
  tip            Float       @default(0.0)
  discount       Float       @default(0.0)
  total          Float
  
  paymentStatus  String      // "PENDING", "PAID", "REFUNDED"
  stripeIntentId String?     
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  
  items          OrderItem[]
  rewardTx       RewardTransaction?
}

model OrderItem {
  id         String             @id @default(cuid())
  orderId    String
  order      Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem           @relation(fields: [menuItemId], references: [id])
  quantity   Int
  price      Float              // captured price at order time
  modifiers  OrderItemModifier[]
}

model OrderItemModifier {
  id           String    @id @default(cuid())
  orderItemId  String
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierName String
  price        Float
}

model Reservation {
  id             String            @id @default(cuid())
  userId         String?
  user           User?             @relation(fields: [userId], references: [id])
  customerName   String
  customerEmail  String
  customerPhone  String
  date           DateTime
  time           String
  guests         Int
  seatingArea    String            // "INDOOR", "OUTDOOR", "PRIVATE"
  specialOccasion String?
  notes          String?
  status         String            @default("PENDING") // "PENDING", "CONFIRMED", "ARRIVED", "NOSHOW", "CANCELLED"
  createdAt      DateTime          @default(now())
}

model CateringRequest {
  id             String         @id @default(cuid())
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])
  customerName   String
  customerEmail  String
  customerPhone  String
  eventType      String
  guestCount     Int
  eventDate      DateTime
  location       String
  menuPreference String
  dietaryNeeds   String?
  servicesNeeded String         // Comma separated values e.g. "staff,buffet-setup"
  notes          String?
  estimatedPrice Float          @default(0.0)
  status         String         @default("NEW") // "NEW", "CONTACTED", "QUOTE_SENT", "CONFIRMED", "COMPLETED", "CANCELLED"
  createdAt      DateTime       @default(now())
}

model GiftCard {
  id             String    @id @default(cuid())
  code           String    @unique // e.g. HIMALAYAN-XXXX-XXXX
  balance        Float
  initialBalance Float
  isActive       Boolean   @default(true)
  senderId       String?
  sender         User?     @relation("SentGiftCards", fields: [senderId], references: [id])
  senderName     String
  recipientName  String
  recipientEmail String
  message        String?
  cardStyle      String    // "birthday", "thank-you", etc.
  scheduledDate  DateTime?
  createdAt      DateTime  @default(now())
  
  transactions   GiftCardTransaction[]
}

model GiftCardTransaction {
  id         String   @id @default(cuid())
  cardId     String
  card       GiftCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  amount     Float    // Negative for charge, positive for load
  description String
  createdAt  DateTime @default(now())
}

model RewardAccount {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points     Int      @default(0)
  createdAt  DateTime @default(now())
  
  transactions RewardTransaction[]
}

model RewardTransaction {
  id         String        @id @default(cuid())
  accountId  String
  account    RewardAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  points     Int           // positive for earn, negative for redeem
  description String
  orderId    String?       @unique
  order      Order?        @relation(fields: [orderId], references: [id])
  createdAt  DateTime      @default(now())
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  
  @@unique([userId, menuItemId])
}

model Job {
  id          String           @id @default(cuid())
  title       String
  location    String
  type        String           // "Full-time", "Part-time"
  schedule    String
  salary      String?
  description String
  isPublished Boolean          @default(true)
  createdAt   DateTime         @default(now())
  applications JobApplication[]
}

model JobApplication {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name        String
  email       String
  phone       String
  resumeUrl   String   // File path or placeholder
  coverLetter String?
  availability String
  status      String   @default("NEW") // "NEW", "REVIEWED", "INTERVIEWED", "REJECTED", "HIRED"
  createdAt   DateTime @default(now())
}

model DeliverySetting {
  id                 String   @id @default("default")
  restaurantName     String   @default("Himalayan Cuisine")
  address            String   @default("115 6th St, Glenwood Springs, CO 81601")
  latitude           Float    @default(39.5505)
  longitude          Float    @default(-107.3248)
  maxRadiusMiles     Float    @default(10.0)
  minOrderAmount     Float    @default(15.0)
  deliveryFee        Float    @default(5.0)
  freeDeliveryOver   Float    @default(50.0)
  isDeliveryEnabled  Boolean  @default(true)
  enforceRadius      Boolean  @default(true)
  outOfRangeMessage  String   @default("Sorry, your address is outside our delivery zone. We only deliver within {radius} miles.")
  updatedAt          DateTime @updatedAt
}

model Event {
  id          String         @id @default(cuid())
  title       String
  tagline     String?
  type        String         @default("Festival Feast") // "Festival Feast", "Culinary Class", "Tasting Dinner"
  schedule    String         // e.g. "October 12, 2026 @ 6:30 PM"
  price       Float          @default(45.0)
  capacity    Int            @default(40)
  location    String         @default("115 6th St, Glenwood Springs, CO 81601")
  image       String         @default("/images/event_dashain.jpg")
  description String
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now())
  bookings    EventBooking[]
}

model EventBooking {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  customerName  String
  customerEmail String
  customerPhone String
  ticketsCount  Int      @default(1)
  totalPaid     Float    @default(0.0)
  notes         String?
  status        String   @default("CONFIRMED") // "CONFIRMED", "CANCELLED", "ATTENDED"
  createdAt     DateTime @default(now())
}


